# Ignore SKILL file (local skill/private info)
SKILL.md

# Binaries for programs and build outputs
/bin/
/build/
/dist/
/out/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go specific
*.test
*.prof
coverage.out
*.coverprofile

# Vendor (optional — uncomment if vendoring is used locally)
/vendor/

# Go build cache and modules (module files should be tracked)
# GOPATH/bin if used locally
GOPATH/bin/

# Tooling caches
.cache/
.golangci-cache/

# IDEs and editors
.vscode/
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store

# Logs
*.log
npm-debug.log
yarn-error.log

# Environment variables and secrets
.env
.env.*
.envrc
*.secret
secrets.*

# Python artifacts (if present)
__pycache__/
*.pyc
.pytest_cache/

# Node/npm
node_modules/

# Playground build output. Both are produced by `make playground` and both are
# tied to the Go toolchain that built them — wasm_exec.js must match the compiler
# that produced polyql.wasm, so a committed copy would be a version mismatch
# waiting to happen. web/examples.js IS committed: it is generated, but it is the
# page's content, not a build artifact.
web/polyql.wasm
web/wasm_exec.js

# Temporary files
*.swp
*~
*.tmp
tmp/

# Coverage and report files
coverage/
coverage-report/

# Misc
Thumbs.db

# Local binaries produced by 'go build' (common pattern)
# Ignore compiled executables in root by name pattern
*.out

