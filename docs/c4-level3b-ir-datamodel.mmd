classDiagram
    direction TB

    class Query {
        +SignalType signal
        +DataSource source
        +Pipeline pipeline
        +Output output
        +map~string,string~ hints
    }

    class SignalType {
        <<enumeration>>
        METRIC
        LOG
        SPAN
        PROFILE
    }

    class DataSource {
        +string name
        +Scope scope
        +Selector[] selectors
        +SpansetSelector spanset
    }

    class SpansetSelector {
        +Predicate filters
    }

    class Scope {
        <<enumeration>>
        RESOURCE
        SPAN
        INTRINSIC
        UNSCOPED
    }

    class Selector {
        +LabelMatcher[] matchers
    }

    class LabelMatcher {
        +string key
        +MatchOp op
        +string value
    }

    class MatchOp {
        <<enumeration>>
        EQ
        NEQ
        REGEX
        NOT_REGEX
        GT
        GTE
        LT
        LTE
        IN
        NOT_IN
        IS_NULL
        IS_NOT_NULL
        CONTAINS
        NOT_CONTAINS
    }

    class Predicate {
        <<interface>>
    }

    class MatchPredicate {
        +LabelMatcher matcher
    }

    class LogicalPredicate {
        +LogicalOp op
        +Predicate[] operands
    }

    class LogicalOp {
        <<enumeration>>
        AND
        OR
        NOT
    }

    class Pipeline {
        +PipelineStage[] stages
    }

    class PipelineStage {
        <<interface>>
    }

    class FilterStage {
        +Predicate predicate
        +bool returnsBool
    }

    class AggregationStage {
        +AggOp op
        +string[] groupBy
        +string[] without
        +AggScope scope
    }

    class AggOp {
        <<enumeration>>
        SUM
        AVG
        MIN
        MAX
        COUNT
        COUNT_DISTINCT
        STDDEV
        QUANTILE
        RATE
        INCREASE
        DELTA
        IRATE
        HISTOGRAM_QUANTILE
        TOPK
        BOTTOMK
    }

    class AggScope {
        <<enumeration>>
        TEMPORAL
        GROUP
    }

    class FunctionStage {
        +string name
        +IRExpr[] args
        +QlsDataType returnType
    }

    class IRExpr {
        <<interface>>
    }

    class LiteralExpr {
        +QlsDataType type
        +any value
    }

    class RefExpr {
        +string name
        +Scope scope
        +QlsDataType type
    }

    class QueryExpr {
        +Query query
    }

    class JoinStage {
        +JoinType joinType
        +string[] onLabels
        +string[] ignoreLabels
        +string[] includeLabels
        +Query rightSide
    }

    class BinaryOpStage {
        +ArithOp op
        +Query left
        +Query right
    }

    class UnaryOpStage {
        +ArithOp op
        +Query operand
    }

    class StructuralStage {
        +StructuralOp op
        +Query right
    }

    class StructuralOp {
        <<enumeration>>
        CHILD
        DESCENDANT
        SIBLING
    }

    class CoercionStage {
        +string attribute
        +QlsDataType targetType
    }

    class ArithOp {
        <<enumeration>>
        ADD
        SUB
        MUL
        DIV
        MOD
        POW
        AND
        OR
        UNLESS
        EQ
        NEQ
        GT
        GTE
        LT
        LTE
        NEG
        POS
    }

    class JoinType {
        <<enumeration>>
        INNER
        LEFT_OUTER
        RIGHT_OUTER
        FULL_OUTER
        CROSS
    }

    class Output {
        +TimeRange range
        +Window window
        +string[] groupBy
        +SortOrder sort
        +int limit
        +Interval subqueryRange
        +Interval subqueryStep
    }

    class TimeRange {
        +Timestamp start
        +Timestamp end
    }

    class Window {
        +Interval step
        +Interval offset
        +WindowAlignment alignment
    }

    class Interval {
        +int64 nanos
        +string sourceText
    }

    class Timestamp {
        +int64 unixNano
    }

    class SortOrder {
        <<enumeration>>
        NONE
        ASC
        DESC
    }

    class WindowAlignment {
        <<enumeration>>
        UTC_NORMALIZED
        CALENDAR_ALIGNED
        QUERY_START_ALIGNED
    }

    class QlsDataType {
        <<enumeration>>
        DOUBLE
        SIGNED_INT
        UNSIGNED_INT
        STRING
        BINARY_STRING
        BOOLEAN
        TIMESTAMP
        INTERVAL
        MAP
        ARRAY
        JSON
    }

    class QlsMetricType {
        <<enumeration>>
        UNKNOWN
        CUMULATIVE_COUNTER
        DELTA_COUNTER
        GAUGE
        RATE
        HISTOGRAM
        APPROXIMATE_COUNT
        APPROXIMATE_DISTRIBUTION
        CUSTOM
    }

    class QlsLogSeverity {
        <<enumeration>>
        TRACE
        DEBUG
        INFO
        WARN
        ERROR
        FATAL
    }

    class QlsSpanKind {
        <<enumeration>>
        UNSPECIFIED
        INTERNAL
        SERVER
        CLIENT
        PRODUCER
        CONSUMER
    }

    class TranslatabilityFlag {
        <<enumeration>>
        FULL
        PARTIAL
        UNSUPPORTED
    }

    class IRNode {
        +TranslatabilityFlag flag
        +string reason
    }

    class SignalMismatchInfo {
        +SignalType sourceSignal
        +string targetSignals
        +string message
    }

    Query --> SignalType
    Query --> DataSource
    Query --> Pipeline
    Query --> Output
    DataSource --> Scope
    DataSource --> Selector
    DataSource --> SpansetSelector
    SpansetSelector --> Predicate : filters
    Predicate <|-- MatchPredicate
    Predicate <|-- LogicalPredicate
    MatchPredicate --> LabelMatcher
    LogicalPredicate --> LogicalOp
    LogicalPredicate --> Predicate : operands
    Selector --> LabelMatcher
    LabelMatcher --> MatchOp
    Pipeline --> PipelineStage
    PipelineStage <|-- FilterStage
    PipelineStage <|-- AggregationStage
    PipelineStage <|-- FunctionStage
    PipelineStage <|-- JoinStage
    PipelineStage <|-- BinaryOpStage
    PipelineStage <|-- UnaryOpStage
    PipelineStage <|-- StructuralStage
    PipelineStage <|-- CoercionStage
    FilterStage --> Predicate
    AggregationStage --> AggOp
    AggregationStage --> AggScope
    AggregationStage --> IRExpr : parameter
    IRExpr <|-- LiteralExpr
    IRExpr <|-- RefExpr
    IRExpr <|-- QueryExpr
    LiteralExpr --> QlsDataType
    RefExpr --> Scope
    RefExpr --> QlsDataType
    QueryExpr --> Query
    FunctionStage --> IRExpr : args
    FunctionStage --> QlsDataType
    JoinStage --> JoinType
    BinaryOpStage --> ArithOp
    BinaryOpStage --> Query : left, right
    UnaryOpStage --> ArithOp
    UnaryOpStage --> Query : operand
    StructuralStage --> StructuralOp
    StructuralStage --> Query : right
    CoercionStage --> QlsDataType
    Output --> TimeRange
    Output --> SortOrder
    Output --> Window
    TimeRange --> Timestamp : start, end
    Window --> WindowAlignment
    Window --> Interval : step, offset
    Output --> Interval : subqueryRange, subqueryStep
    IRNode --> TranslatabilityFlag
    SignalMismatchInfo --> SignalType
